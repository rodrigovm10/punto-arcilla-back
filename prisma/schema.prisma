// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  BUYER
}

enum Status {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELD
}

enum ReservedStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model User {
  id                      String @id @default(cuid())
  email                   String @unique
  password                String 
  role                    Role?
  created_at              DateTime @default(now())
  
  
  profile                 Profile?
  addresses               Address[]
  products                Product []
  cart                    Cart?
  order                   Order[]
  favorites               Favorite[]
  reservedAsCustomer      Reserved[] @relation("CustomerRelation")
  reservedAsRecipient     Reserved[] @relation("RecipientRelation")

  @@map("users")
}

model Profile {
  id                      String @id @default(cuid())
  user_id                 String @unique
  name                    String @default("")
  business_description    String?
  avatar                  String?
  
  user User @relation(fields: [user_id], references: [id])

  @@map("profiles")
}

model Address {
  id                      String @id @default(cuid())
  user_id                 String
  street                  String
  city                    String
  state                   String
  neighborhood            String
  postal_code             Int
  house_number            Int

  user User @relation(fields: [user_id], references: [id])

  @@map("addresses")
}

model Product {
  id                      String @id @default(cuid())
  user_id                 String
  name                    String
  description             String
  stock                   Int
  price                   Decimal
  status                  Boolean @default(true)
  tags                    String[]
  images                  String[]
  created_at              DateTime @default(now())
  cart_items              CartItem[]
  favorites               ProductsOnFavorites[]
  reserved                Reserved[]
  can_be_reserved         Boolean @default(false)
  percentage_reservation  Decimal? @default(0.0)
  
  user User @relation(fields: [user_id], references: [id])

  @@map("products")
}

model Cart{
  id                      String        @id @default(cuid())
  created_at              DateTime      @default(now())
  cart_items              CartItem[]
  user_id                 String        @unique
  
  order                   Order?
  user                    User          @relation(fields: [user_id], references: [id])

  @@map("carts")
}

model CartItem{
  id                      String  @id @default(cuid())
  quantity                Int
  cart_id                 String
  product_id              String 

  product                 Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart                    Cart    @relation(fields: [cart_id], references: [id]) 
  
  @@map("cart_items")
}

model Order {
  id                      String @id @default(cuid())
  user_id                 String @unique
  order_date              DateTime    @default(now())
  status                  Status  
  total_amount            Decimal
  cart_id                 String @unique
  user_id_seller           String

  cart                    Cart @relation(fields: [cart_id], references: [id])
  user                    User @relation(fields: [user_id], references: [id])

  @@map("orders")
}

model Favorite {
  id                      String @id @default(cuid())
  user_id                 String @unique
  products                ProductsOnFavorites[]

  user                    User @relation(fields: [user_id], references: [id])

  @@map("favorites")
}

model Reserved {
  id             String          @id @default(cuid())
  product_id     String
  customer_id    String
  recipient_id   String
  status         ReservedStatus  @default(PENDING)

  product        Product         @relation(fields: [product_id], references: [id])
  customer       User            @relation("CustomerRelation", fields: [customer_id], references: [id], onDelete: Cascade)
  recipient      User            @relation("RecipientRelation", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@map("reserved")
  @@unique([product_id, customer_id]) 
}

model ProductsOnFavorites{
  product_id        String 
  favorite_id       String 

  product           Product @relation(fields: [product_id], references: [id])
  favorite          Favorite @relation(fields: [favorite_id], references: [id])
  
  @@unique([product_id, favorite_id])
}
